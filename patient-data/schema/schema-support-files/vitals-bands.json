{
  "conventions": {
    "purpose": "Machine-readable mirror of vitals-bands.md. Defines the fixed color thresholds for every vital sign by age band. The audit script audit-vitals-bands.mjs uses this file to verify (and optionally fix) the stored colors in patient-json/.",
    "authority": "vitals-bands.md is the authoritative human-readable definition; keep this file in sync with it.",
    "lookup": "Find the band row for the vital where ageLow <= floor(age) <= ageHigh (inclusive). If the value is inside the green [low, high] range (inclusive) the color is green; else if inside any yellow [low, high] range it is yellow; otherwise it is red.",
    "bp": "bp is colored by the systolic value only (the number before the slash). Diastolic is displayed but never drives color.",
    "temp": "temp values are Celsius, compared as decimals (e.g. 38.9 is yellow, 39.0 is red).",
    "ages": "Ages 65+ deliberately use the adult band. Infant means under 1 year (floor(age) = 0).",
    "established": "2026-08-01"
  },
